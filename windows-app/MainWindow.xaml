<Window x:Class="MechrevoControl.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无界 14 MAX 控制台 · 演示数据"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        Background="#FF0F1319"
        Foreground="#FFF1F5F9"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Text="无界 14 MAX 控制台" FontSize="20" FontWeight="SemiBold" Foreground="#FFF8FAFC" />
          <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="12" Foreground="#FF94A3B8" Text="演示数据 · Dove4 / Intel Core Ultra 7 256V · 单进程普通权限" />
        </StackPanel>
        <Button x:Name="ReconnectBtn" DockPanel.Dock="Right" Content="重新连接" Padding="12,6" Visibility="Collapsed" Click="OnReconnectClick" Background="#FFD97706" Foreground="White" BorderThickness="0" />
      </DockPanel>

      <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,16,0,0" Padding="12" CornerRadius="6" Background="#28EF4444" BorderBrush="#66EF4444" BorderThickness="1">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="#FFFECACA" />
      </Border>

      <!-- Current Status Summary -->
      <Border Margin="0,18,0,0" Padding="16" CornerRadius="8" Background="#FF151A21" BorderBrush="#FF1E293B" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="当前策略 · 硬件档位" FontSize="11" Foreground="#FF94A3B8" />
            <TextBlock x:Name="ConfirmedModeText" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Text="手动控制 · 硬件平衡档" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="供电与充电状态" FontSize="11" Foreground="#FF94A3B8" />
            <TextBlock x:Name="PowerText" Margin="0,6,0,0" FontSize="14" Text="交流电源 · 未充电" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="CPU 封装功耗 / 电量" FontSize="11" Foreground="#FF94A3B8" />
            <TextBlock x:Name="TelemetryText" Margin="0,6,0,0" FontSize="14" FontFamily="Consolas" Text="17.09 W · 92%" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Two-Mode Confirmed Switch -->
      <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" Background="#FF151A21" BorderBrush="#FF1E293B" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="硬件性能档位（仅在读回确认后更新）" FontSize="14" FontWeight="SemiBold" />
          <UniformGrid Columns="2" Margin="0,12,0,0">
            <Button x:Name="BalancedBtn" Content="平衡（Balanced · PPMD 1）" Margin="0,0,6,0" Padding="14,12" Click="OnBalancedClick" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" />
            <Button x:Name="PerformanceBtn" Content="性能（Performance · PPMD 2）" Margin="6,0,0,0" Padding="14,12" Click="OnPerformanceClick" Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" />
          </UniformGrid>
          <TextBlock x:Name="SwitchHintText" Margin="0,10,0,0" FontSize="12" Foreground="#FF94A3B8" Text="智能选档与日用流畅待后端确认可用后开放实机写入。" />
        </StackPanel>
      </Border>

      <!-- Demo Scenario Controls -->
      <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" Background="#FF151A21" BorderBrush="#FF1E293B" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="演示场景控制（用于验收成功、失败、断线与 OSD）" FontSize="13" FontWeight="SemiBold" />
          <WrapPanel Margin="0,10,0,0">
            <ComboBox x:Name="OutcomeCombo" Width="210" Margin="0,0,10,8" SelectionChanged="OnOutcomeChanged">
              <ComboBoxItem Content="切档预设：读回确认成功" IsSelected="True" />
              <ComboBoxItem Content="切档预设：写后读回不一致" />
              <ComboBoxItem Content="切档预设：权限不足" />
              <ComboBoxItem Content="切档预设：读回超时" />
            </ComboBox>
            <Button Content="模拟服务断线" Padding="10,6" Margin="0,0,8,8" Click="OnDisconnectClick" />
            <Button Content="预览触摸板 OSD (0x30)" Padding="10,6" Margin="0,0,8,8" Click="OnDemoTouchpadOsdClick" />
            <Button Content="预览刷新率 OSD (4000ms)" Padding="10,6" Margin="0,0,8,8" Click="OnDemoRefreshOsdClick" />
          </WrapPanel>
          <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF64748B" Text="提示：点击窗口右上角 × 关闭主窗口将彻底释放 UI 并暂停遥测，程序继续驻留在系统托盘并响应热键 OSD。" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
