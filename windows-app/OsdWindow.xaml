<Window x:Class="MechrevoControl.Frontend.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="320"
        Height="86"
        WindowStartupLocation="Manual">
  <Border CornerRadius="10"
          Background="#F0161B23"
          BorderBrush="#FF2E3847"
          BorderThickness="1"
          Padding="14,10">
    <StackPanel VerticalAlignment="Center">
      <DockPanel>
        <TextBlock x:Name="TitleText" Foreground="#FF94A3B8" FontSize="12" FontFamily="Microsoft YaHei UI" />
        <TextBlock x:Name="CodeText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#FF64748B" FontSize="11" FontFamily="Consolas" />
      </DockPanel>
      <TextBlock x:Name="StateText" Margin="0,4,0,0" Foreground="#FFF8FAFC" FontSize="15" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" />
    </StackPanel>
  </Border>
</Window>
